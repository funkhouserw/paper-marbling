// Hosting on Cloudflare (Workers static assets), the same setup as Ilse's blog. Nothing is
// deployed until Ilse says so. `npm run deploy` builds dist/ and uploads it.
{
  "name": "marbler",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Ilse picks the hostname (for example marbler.corporateshill.com), then this becomes:
  // "routes": [{ "pattern": "<hostname>", "custom_domain": true }],
  "workers_dev": false
}
